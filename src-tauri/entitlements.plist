<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- What a signed, notarized Cue (hardened runtime) may do. Only release builds use it (scripts/release.sh). -->
<plist version="1.0">
<dict>
  <!-- Reply, focus and open tabs in iTerm / Terminal (macOS asks you once). -->
  <key>com.apple.security.automation.apple-events</key>
  <true/>
  <!-- Dictation: the mic, while you talk into a message box. -->
  <key>com.apple.security.device.audio-input</key>
  <true/>
</dict>
</plist>
