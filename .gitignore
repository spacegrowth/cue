# Folders, and the links an item's copy has in their place (hub/desk_trees.rs): a trailing / would match folders only.
node_modules
src-tauri/target
src-tauri/gen/
src-tauri/binaries/
src-tauri/target-clean/
src-tauri/target-staged/
# Any other build folder made beside target/ (a session's own CARGO_TARGET_DIR)
src-tauri/target-*/

# An optional add-on, kept outside this repo (built in with the `ext` feature)
src-tauri/ext

# Release builds (scripts/release.sh)
dist/
# Local release settings (scripts/release.sh)
.release.env
# The next release's notes (scripts/release-next.sh)
.release-notes

# Swift builds of the voices and voice helpers (src-tauri/speak, src-tauri/voice)
src-tauri/speak/.build/
src-tauri/voice/.build/

# UI test screenshots (tests/ui/specs): the latest run's; the baselines are tests/ui/baseline
tests/ui/shots/

# cue-host for other machines (scripts/build-host.sh), carried in Cue.app
src-tauri/host-builds/

# Claude Code: the project's shared permission settings are kept; everything else in .claude/ (worktrees, local settings) is not
.claude/*
!.claude/settings.json

# Playwright writes its last run and failure notes here.
test-results
